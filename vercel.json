{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "true",
  "buildCommand": "bash tools/vercel_build.sh",
  "outputDirectory": "build/web",
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
